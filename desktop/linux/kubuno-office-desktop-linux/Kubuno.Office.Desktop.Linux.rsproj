<Project Sdk="Kubuno.Rust.Sdk/1.1.1">

  <!-- Generated by "Kubuno Web: Generate Solution" (docs/WEB.md): a desktop app of the module. This file is
       yours: it is never overwritten by a later run - edit it freely, or delete it and run the command again. -->
  <PropertyGroup>
    <CargoPackage>kubuno-office-desktop-linux</CargoPackage>
    <CargoBin>kubuno-documents</CargoBin>
    <!-- One `cargo build` of the desktop workspace for every project of it (docs/RSPROJ.md, "Cargo workspaces"). -->
    <CargoBuildScope>Workspace</CargoBuildScope>
  </PropertyGroup>

</Project>
