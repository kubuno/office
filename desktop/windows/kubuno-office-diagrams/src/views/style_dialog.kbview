<!--
  « Modifier le style » (the web's style JSON dialog, DiagramEditorPage.tsx:3989-4008): the selected shape's
  raw style as JSON, `rows={10}` monospace, « Appliquer » / « Annuler ». Invalid JSON keeps the dialog open.
  StyleDialog (style_dialog.rs) fills it in and parses it.
-->
<Panel xmlns="https://kubuno.com/views" xmlns:x="https://kubuno.com/views/x" DesignWidth="420" DesignHeight="240" WindowKind="Dialog" Title="{Res style_title}" CancelButton="cancel">
  <TextArea x:Name="style_box" Text="{Binding Json, Mode=TwoWay}" Invalid="{Binding Invalid}" Font="Consolas, 9pt" X="16" Y="16" Width="388" Height="208" Anchor="Top, Bottom, Left, Right"/>
  <Button x:Name="cancel" ActionBar.Region="Right" Text="{Res cancel}" Variant="Secondary" Width="96" Height="36" OnClick="cancel_click"/>
  <Button x:Name="apply_button" ActionBar.Region="Right" Text="{Res apply}" Variant="Primary" Width="96" Height="36" OnClick="apply_click"/>
</Panel>
