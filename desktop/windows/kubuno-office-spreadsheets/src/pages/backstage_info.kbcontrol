<!--
  « Fichier › Informations »: what is known about the open workbook - its title, its sheets and where it
  comes from (a local file or the server). The form sets its properties.
-->
<UserControl xmlns="https://kubuno.com/views" xmlns:x="https://kubuno.com/views/x" xmlns:d="https://kubuno.com/views/design" x:Class="BackstageInfo" DesignWidth="760" DesignHeight="170">
  <Label x:Name="heading" Text="{Res bs_info}" Role="Title" TextAlign="MiddleLeft" X="0" Y="4" Width="728" Height="32" Anchor="Top, Left, Right"/>
  <Label x:Name="title_key" Text="{Res info_title}" ForeColor="TextSecondary" TextAlign="MiddleLeft" X="0" Y="56" Width="140" Height="22"/>
  <Label x:Name="title_value" Text="{Binding WorkbookTitle}" d:Text="Budget 2026" TextAlign="MiddleLeft" X="150" Y="56" Width="578" Height="22" Anchor="Top, Left, Right"/>
  <Label x:Name="sheets_key" Text="{Res info_sheets}" ForeColor="TextSecondary" TextAlign="MiddleLeft" X="0" Y="86" Width="140" Height="22"/>
  <Label x:Name="sheets_value" Text="{Binding Sheets}" d:Text="2" TextAlign="MiddleLeft" X="150" Y="86" Width="578" Height="22" Anchor="Top, Left, Right"/>
  <Label x:Name="source_key" Text="{Res info_source}" ForeColor="TextSecondary" TextAlign="MiddleLeft" X="0" Y="116" Width="140" Height="22"/>
  <Label x:Name="source_value" Text="{Binding Source}" d:Text="Fichier local" TextAlign="MiddleLeft" X="150" Y="116" Width="578" Height="22" Anchor="Top, Left, Right"/>
</UserControl>
