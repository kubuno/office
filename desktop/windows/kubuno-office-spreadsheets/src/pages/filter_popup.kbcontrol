<!--
  The column filter (the web's ColumnFilterPopup, SpreadsheetApp.tsx:556): a search box, « Tout sélectionner » /
  « Effacer », the column's distinct values with their checkboxes (the blanks read « (Vides) »), OK and Annuler.
  230 wide like the web; the window puts it in a popup under the header's funnel and applies what OK raises.
-->
<UserControl xmlns="https://kubuno.com/views" xmlns:x="https://kubuno.com/views/x" xmlns:d="https://kubuno.com/views/design" x:Class="FilterPopup" DesignWidth="230" DesignHeight="320" BackColor="Surface1">
  <TextField x:Name="search_box" Text="{Binding Query, Mode=TwoWay}" Placeholder="{Res filter_search}" AccessibleName="{Res filter_search}" X="8" Y="8" Width="214" Height="28" Anchor="Top, Left, Right" OnTextChanged="search_box_text_changed"/>
  <LinkLabel x:Name="all_link" Text="{Res filter_all}" AutoSize="true" X="8" Y="42" Height="16" OnClick="all_link_click"/>
  <LinkLabel x:Name="clear_link" Text="{Res filter_clear}" AutoSize="true" X="118" Y="42" Height="16" OnClick="clear_link_click"/>
  <Separator x:Name="top_rule" Orientation="Horizontal" X="0" Y="64" Width="230" Height="1" Anchor="Top, Left, Right"/>
  <ValueList x:Name="values" Items="{Binding ShownItems}" CheckedItems="{Binding CheckedItems}" Checkable="true" BlankText="{Res filter_blanks}" EmptyText="-" RowHeight="26" AccessibleName="{Res filter_values}" X="0" Y="68" Width="230" Height="206" Anchor="Top, Bottom, Left, Right" OnItemClick="values_item_click"/>
  <Separator x:Name="bottom_rule" Orientation="Horizontal" X="0" Y="277" Width="230" Height="1" Anchor="Bottom, Left, Right"/>
  <Button x:Name="ok_button" Text="{Res filter_ok}" Variant="Primary" X="64" Y="284" Width="56" Height="28" Anchor="Bottom, Right" OnClick="ok_button_click"/>
  <Button x:Name="cancel_button" Text="{Res cancel}" Variant="Ghost" X="126" Y="284" Width="96" Height="28" Anchor="Bottom, Right" OnClick="cancel_button_click"/>
</UserControl>
