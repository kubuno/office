<!--
  A text to type (rename a sheet, write a comment): the web edits them in place; here a small dialog with
  the current text. PromptDialog (prompt_dialog.rs) fills it in and reads it.
-->
<Panel xmlns="https://kubuno.com/views" xmlns:x="https://kubuno.com/views/x" DesignWidth="400" DesignHeight="120" WindowKind="Dialog" Title="{Binding Caption}" AcceptButton="ok" CancelButton="cancel">
  <Label x:Name="prompt_label" Text="{Binding Label}" X="24" Y="16" Width="352" Height="20" Anchor="Top, Left, Right"/>
  <TextField x:Name="value_box" Text="{Binding Value, Mode=TwoWay}" X="24" Y="40" Width="352" Height="32" Anchor="Top, Left, Right"/>
  <Button x:Name="cancel" ActionBar.Region="Right" Text="{Res cancel}" Variant="Secondary" Width="96" Height="36" OnClick="cancel_click"/>
  <Button x:Name="ok" ActionBar.Region="Right" Text="OK" Variant="Primary" Width="96" Height="36" OnClick="ok_click"/>
</Panel>
