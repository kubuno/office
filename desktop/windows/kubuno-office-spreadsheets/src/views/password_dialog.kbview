<!--
  The password dialogs (the web's SheetProtectDialog.tsx and WorkbookEncryptDialog.tsx): protect / unprotect the
  sheet, encrypt / decrypt / unlock the workbook. A new password is typed twice with the warning; a wrong one
  keeps the dialog open with « Mot de passe incorrect ». PasswordDialog (password_dialog.rs) checks and reports.
-->
<Panel xmlns="https://kubuno.com/views" xmlns:x="https://kubuno.com/views/x" xmlns:d="https://kubuno.com/views/design" DesignWidth="440" DesignHeight="270" WindowKind="Dialog" Title="{Binding Caption}" AcceptButton="ok_button" CancelButton="cancel_button">
  <Label x:Name="pwd_label" Text="{Res prot_pwd}" ForeColor="TextSecondary" X="24" Y="16" Width="392" Height="18" Anchor="Top, Left, Right"/>
  <TextField x:Name="pwd_box" Text="{Binding Password, Mode=TwoWay}" PasswordChar="●" AccessibleName="{Res prot_pwd}" X="24" Y="36" Width="392" Height="32" Anchor="Top, Left, Right"/>
  <Label x:Name="confirm_label" Text="{Res prot_confirm}" ForeColor="TextSecondary" Visible="{Binding IsNew}" X="24" Y="78" Width="392" Height="18" Anchor="Top, Left, Right"/>
  <TextField x:Name="confirm_box" Text="{Binding Confirm, Mode=TwoWay}" PasswordChar="●" Visible="{Binding IsNew}" AccessibleName="{Res prot_confirm}" X="24" Y="98" Width="392" Height="32" Anchor="Top, Left, Right"/>
  <Label x:Name="desc_label" Text="{Res enc_unlock_desc}" ForeColor="TextSecondary" Overflow="Wrap" Visible="{Binding IsUnlock}" d:Visible="false" X="24" Y="80" Width="392" Height="48" Anchor="Top, Left, Right"/>
  <Callout x:Name="warn_callout" Body="{Binding Warning}" Variant="Warning" Visible="{Binding IsNew}" X="24" Y="142" Width="392" Height="60" Anchor="Top, Left, Right"/>
  <Label x:Name="error_label" Text="{Binding Error}" ForeColor="Danger" Visible="{Binding HasError}" d:Visible="false" X="24" Y="208" Width="392" Height="18" Anchor="Top, Left, Right"/>
  <Button x:Name="cancel_button" ActionBar.Region="Right" Text="{Res cancel}" Variant="Ghost" Width="96" Height="36" OnClick="cancel_button_click"/>
  <Button x:Name="ok_button" ActionBar.Region="Right" Text="{Binding Action}" Variant="Primary" Width="150" Height="36" OnClick="ok_button_click"/>
</Panel>
