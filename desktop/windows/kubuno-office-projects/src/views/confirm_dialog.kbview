<!--
  A question the project cannot answer for the user: keep the edits made on this PC
  or take the server's values when they changed meanwhile. The shell's confirmation
  dialog (shell/src/views/confirm_dialog.kbview), vendored: an app never links the shell. Enter
  confirms; the second action declines; closing (Escape, the close box) answers nothing. ConfirmDialog (confirm_dialog.rs) fills it in.
-->
<Panel xmlns="https://kubuno.com/views" xmlns:x="https://kubuno.com/views/x" DesignWidth="480" DesignHeight="150" WindowKind="Dialog" Title="Kubuno Projects" AcceptButton="confirm">
  <Icon x:Name="glyph" Name="AlertTriangle" Disc="Warning" Size="40" X="24" Y="24" Width="40" Height="40"/>
  <Label x:Name="message" Text="" Overflow="Wrap" TextAlign="TopLeft" X="80" Y="24" Width="356" Height="100" Anchor="Top, Bottom, Left, Right"/>
  <Button x:Name="cancel" ActionBar.Region="Right" Text="" Variant="Secondary" Width="200" Height="36" OnClick="cancel_click"/>
  <Button x:Name="confirm" ActionBar.Region="Right" Text="OK" Variant="Primary" Width="200" Height="36" OnClick="confirm_click"/>
</Panel>
