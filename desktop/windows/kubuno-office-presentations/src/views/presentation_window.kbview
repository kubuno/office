    <RibbonBackstage x:Name="backstage" Header="{Res tab_file}" KeyTip="F">
      <BackstageTab x:Name="bs_info" Header="{Res bs_info}" Icon="Info">
        <PresentationInfo x:Name="backstage_info" PresentationTitle="{Binding PresTitle}" Format="{Binding PresFormat}" Slides="{Binding SlidesText}"/>
      </BackstageTab>
      <BackstageButton x:Name="bs_open" Label="{Res cmd_open_file}" SmallIcon="FolderOpen" OnClick="open_file_execute"/>
      <BackstageButton x:Name="bs_save_copy" Label="{Res cmd_save_copy}" SmallIcon="Download" OnClick="save_copy_execute"/>
      <BackstageButton x:Name="bs_pdf" Label="{Res cmd_export_pdf}" SmallIcon="FileDown" OnClick="export_pdf_execute"/>
      <BackstageSeparator/>
      <BackstageButton x:Name="bs_close" Label="{Res bs_close}" SmallIcon="X" OnClick="bs_close_click"/>
    </RibbonBackstage>
    <RibbonTab x:Name="tab_home" Header="{Res tab_home}" KeyTip="H">
