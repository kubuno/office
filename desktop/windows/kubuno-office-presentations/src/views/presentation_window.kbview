<!--
  Kubuno Presentations' window, laid out like the web editor (PresentationEditorPage.tsx): the tall 64-DIP title
  bar with the waffle and account menus (the web's chromeless OfficeShell, topbarHeight 64), the ribbon (Fichier,
  Accueil, Insertion, Disposition, Animations, Transitions, and Â« Forme Â» when a shape is selected), the floating
  toolbar row (tools, insertions, the contextual format bars), then the slide list, the slide canvas with the
  presenter notes under it, the slide panel on the right, and the status bar.
  PresentationWindow (presentation_window.rs) opens the presentation into the controls and turns every command
  into the workspace's operations (desktop/common, model/workspace.rs).
-->
<Panel xmlns="https://kubuno.com/views" xmlns:x="https://kubuno.com/views/x" DesignWidth="1280" DesignHeight="860" Title="{Binding WindowTitle}" Icon="{Res app_icon}" ShowIcon="false"
       TitleBarStyle="Tall" ShowWaffle="true" ShowAccount="true"
       OnLoad="presentation_window_load" OnFormClosing="presentation_window_closing">
  <Timer x:Name="publish_timer" Interval="1000" Enabled="{Binding PublishPending}" OnTick="publish_tick"/>
  <!-- The commands (component tray): one per action, shared by the ribbon, the menus, the toolbar and the shortcuts. -->
  <Command x:Name="cmd_save" Label="{Res cmd_save}" SmallIcon="Save" Shortcut="Ctrl+S" OnExecute="save_execute"/>
  <Command x:Name="cmd_undo" Label="{Res cmd_undo}" SmallIcon="Undo2" Shortcut="Ctrl+Z" Enabled="{Binding CanUndo}" OnExecute="undo_execute"/>
  <Command x:Name="cmd_redo" Label="{Res cmd_redo}" SmallIcon="Redo2" Shortcut="Ctrl+Y" Enabled="{Binding CanRedo}" OnExecute="redo_execute"/>
  <Command x:Name="cmd_redo2" Label="{Res cmd_redo}" Shortcut="Ctrl+Shift+Z" OnExecute="redo_execute"/>
  <!-- Accueil -->
  <Command x:Name="cmd_paste_slides" Label="{Res cmd_paste}" SmallIcon="ClipboardPaste" Enabled="{Binding CanPasteSlides}" OnExecute="paste_slides_execute"/>
  <Command x:Name="cmd_cut_slides" Label="{Res cmd_cut}" SmallIcon="Scissors" OnExecute="cut_slides_execute"/>
  <Command x:Name="cmd_copy_slides" Label="{Res cmd_copy}" SmallIcon="Copy" OnExecute="copy_slides_execute"/>
  <Command x:Name="cmd_cliphist" Label="{Res cmd_cliphist}" SmallIcon="ClipboardList" Enabled="false"/>
  <Command x:Name="cmd_new_slide" Label="{Res cmd_new_slide}" SmallIcon="FilePlus2" Shortcut="Ctrl+M" OnExecute="new_slide_execute"/>
  <Command x:Name="cmd_dup_slide" Label="{Res cmd_dup_slide}" SmallIcon="CopyPlus" OnExecute="dup_slide_execute"/>
  <Command x:Name="cmd_export_pdf" Label="{Res cmd_export_pdf}" SmallIcon="FileDown" OnExecute="export_pdf_execute"/>
  <Command x:Name="cmd_export_png" Label="{Res cmd_export_png}" SmallIcon="Image" OnExecute="export_png_execute"/>
  <Command x:Name="cmd_export_jpg" Label="{Res cmd_export_jpg}" SmallIcon="Image" OnExecute="export_jpg_execute"/>
  <Command x:Name="cmd_export_all" Label="{Res cmd_export_all}" SmallIcon="Image" OnExecute="export_all_execute"/>
  <Command x:Name="cmd_slideshow" Label="{Res cmd_slideshow}" SmallIcon="Play" LargeIcon="Play" Shortcut="F5" OnExecute="slideshow_execute"/>
  <!-- The slide list's menu -->
  <Command x:Name="cmd_del_slides" Label="{Res cmd_delete}" SmallIcon="Trash2" OnExecute="delete_slides_execute"/>
  <Command x:Name="cmd_hide_slides" Label="{Binding HideLabel}" SmallIcon="EyeOff" OnExecute="hide_slides_execute"/>
  <Command x:Name="cmd_move_up" Label="{Res cmd_move_up}" SmallIcon="ChevronLeft" OnExecute="move_up_execute"/>
  <Command x:Name="cmd_move_down" Label="{Res cmd_move_down}" SmallIcon="ChevronRight" OnExecute="move_down_execute"/>
  <Command x:Name="cmd_background" Label="{Res cmd_background}" SmallIcon="Droplet" OnExecute="background_execute"/>
  <Command x:Name="cmd_bg_dialog" Label="{Res cmd_background}" SmallIcon="Droplet" OnExecute="bg_dialog_execute"/>
  <Command x:Name="cmd_layout_disabled" Label="{Res cmd_layout}" SmallIcon="LayoutTemplate" Enabled="false"/>
  <Command x:Name="cmd_theme" Label="{Res cmd_theme}" SmallIcon="Paintbrush" Enabled="false"/>
  <Command x:Name="cmd_transition_menu" Label="{Res cmd_transition}" SmallIcon="Replace" Enabled="false"/>
  <Command x:Name="cmd_comment" Label="{Res cmd_comment}" SmallIcon="MessageSquarePlus" Enabled="false"/>
  <Command x:Name="cmd_paste_plain" Label="{Res cmd_paste_plain}" SmallIcon="ClipboardX" Enabled="false"/>
  <!-- Elements (canvas menus, Disposition) -->
  <Command x:Name="cmd_cut_el" Label="{Res cmd_cut}" SmallIcon="Scissors" OnExecute="cut_el_execute"/>
  <Command x:Name="cmd_copy_el" Label="{Res cmd_copy}" SmallIcon="Copy" OnExecute="copy_el_execute"/>
  <Command x:Name="cmd_paste_el" Label="{Res cmd_paste}" SmallIcon="ClipboardPaste" Enabled="{Binding CanPasteElements}" OnExecute="paste_el_execute"/>
  <Command x:Name="cmd_delete_el" Label="{Res cmd_delete}" SmallIcon="Trash2" OnExecute="delete_el_execute"/>
  <Command x:Name="cmd_alt" Label="{Res cmd_alt}" SmallIcon="Accessibility" Shortcut="Ctrl+Alt+Y" OnExecute="alt_execute"/>
  <Command x:Name="cmd_rot_right" Label="{Res cmd_rot_right}" SmallIcon="RotateCw" OnExecute="rot_right_execute"/>
  <Command x:Name="cmd_rot_left" Label="{Res cmd_rot_left}" SmallIcon="RotateCcw" OnExecute="rot_left_execute"/>
  <Command x:Name="cmd_flip_h" Label="{Res cmd_flip_h}" SmallIcon="FlipHorizontal" OnExecute="flip_h_execute"/>
  <Command x:Name="cmd_flip_v" Label="{Res cmd_flip_v}" SmallIcon="FlipVertical" OnExecute="flip_v_execute"/>
  <Command x:Name="cmd_rot_reset" Label="{Res cmd_rot_reset}" SmallIcon="RotateCw" OnExecute="rot_reset_execute"/>
  <Command x:Name="cmd_same_type" Label="{Res cmd_same_type}" SmallIcon="Focus" OnExecute="same_type_execute"/>
  <Command x:Name="cmd_center_h" Label="{Res cmd_center_h}" SmallIcon="AlignHorizontalSpaceAround" OnExecute="center_h_execute"/>
  <Command x:Name="cmd_center_v" Label="{Res cmd_center_v}" SmallIcon="AlignVerticalSpaceAround" OnExecute="center_v_execute"/>
  <Command x:Name="cmd_duplicate" Label="{Res cmd_duplicate}" SmallIcon="CopyPlus" Shortcut="Ctrl+D" OnExecute="duplicate_execute"/>
  <Command x:Name="cmd_group" Label="{Res cmd_group}" SmallIcon="Group" Shortcut="Ctrl+G" Enabled="{Binding CanGroup}" OnExecute="group_execute"/>
  <Command x:Name="cmd_ungroup" Label="{Res cmd_ungroup}" SmallIcon="Ungroup" Shortcut="Ctrl+Shift+G" Enabled="{Binding CanUngroup}" OnExecute="ungroup_execute"/>
  <Command x:Name="cmd_front" Label="{Res cmd_front}" SmallIcon="BringToFront" LargeIcon="BringToFront" OnExecute="front_execute"/>
  <Command x:Name="cmd_back" Label="{Res cmd_back}" SmallIcon="SendToBack" LargeIcon="SendToBack" OnExecute="back_execute"/>
  <Command x:Name="cmd_forward" Label="{Res cmd_forward}" SmallIcon="ChevronRight" OnExecute="forward_execute"/>
  <Command x:Name="cmd_backward" Label="{Res cmd_backward}" SmallIcon="ChevronLeft" OnExecute="backward_execute"/>
  <Command x:Name="cmd_al_left" Label="{Res cmd_al_left}" SmallIcon="AlignStartVertical" OnExecute="al_left_execute"/>
  <Command x:Name="cmd_al_center" Label="{Res cmd_al_center}" SmallIcon="AlignCenterVertical" OnExecute="al_center_execute"/>
  <Command x:Name="cmd_al_right" Label="{Res cmd_al_right}" SmallIcon="AlignEndVertical" OnExecute="al_right_execute"/>
  <Command x:Name="cmd_al_top" Label="{Res cmd_al_top}" SmallIcon="AlignStartHorizontal" OnExecute="al_top_execute"/>
  <Command x:Name="cmd_al_middle" Label="{Res cmd_al_middle}" SmallIcon="AlignCenterHorizontal" OnExecute="al_middle_execute"/>
  <Command x:Name="cmd_al_bottom" Label="{Res cmd_al_bottom}" SmallIcon="AlignEndHorizontal" OnExecute="al_bottom_execute"/>
  <Command x:Name="cmd_dist_h" Label="{Res cmd_dist_h}" SmallIcon="AlignHorizontalDistributeCenter" OnExecute="dist_h_execute"/>
  <Command x:Name="cmd_dist_v" Label="{Res cmd_dist_v}" SmallIcon="AlignVerticalDistributeCenter" OnExecute="dist_v_execute"/>
  <Command x:Name="cmd_same_w" Label="{Res cmd_same_w}" SmallIcon="MoveHorizontal" OnExecute="same_w_execute"/>
  <Command x:Name="cmd_same_h" Label="{Res cmd_same_h}" SmallIcon="MoveVertical" OnExecute="same_h_execute"/>
  <Command x:Name="cmd_same_both" Label="{Res cmd_same_both}" SmallIcon="Maximize2" OnExecute="same_both_execute"/>
  <Command x:Name="cmd_swap" Label="{Res cmd_swap}" SmallIcon="Repeat" OnExecute="swap_execute"/>
  <Command x:Name="cmd_rotate90" Label="{Res cmd_rotate90}" SmallIcon="RotateCw" OnExecute="rot_right_execute"/>
  <Command x:Name="cmd_center_slide" Label="{Res cmd_center_slide}" SmallIcon="Focus" OnExecute="center_slide_execute"/>
  <Command x:Name="cmd_stretch_w" Label="{Res cmd_stretch_w}" SmallIcon="MoveHorizontal" OnExecute="stretch_w_execute"/>
  <Command x:Name="cmd_stretch_h" Label="{Res cmd_stretch_h}" SmallIcon="MoveVertical" OnExecute="stretch_h_execute"/>
  <Command x:Name="cmd_link" Label="{Res cmd_link}" SmallIcon="Link" Shortcut="Ctrl+K" OnExecute="link_execute"/>
  <Command x:Name="cmd_copy_style" Label="{Res cmd_copy_style}" SmallIcon="Paintbrush" OnExecute="copy_style_execute"/>
  <Command x:Name="cmd_paste_style" Label="{Res cmd_paste_style}" SmallIcon="Paintbrush" Enabled="{Binding HasStyleClip}" OnExecute="paste_style_execute"/>
  <Command x:Name="cmd_shadow" Label="{Res cmd_shadow}" SmallIcon="Square" IsCheckable="true" Checked="{Binding Shadow}" OnExecute="shadow_execute"/>
  <Command x:Name="cmd_lock" Label="{Binding LockLabel}" SmallIcon="Lock" OnExecute="lock_execute"/>
  <Command x:Name="cmd_hide_el" Label="{Res cmd_hide}" SmallIcon="EyeOff" OnExecute="hide_el_execute"/>
  <Command x:Name="cmd_change_shape" Label="{Res cmd_change_shape}" SmallIcon="Shapes"/>
  <Command x:Name="cmd_arrow_end" Label="{Binding ArrowEndLabel}" SmallIcon="MoveRight" OnExecute="arrow_end_execute"/>
  <Command x:Name="cmd_arrow_start" Label="{Binding ArrowStartLabel}" SmallIcon="MoveLeft" OnExecute="arrow_start_execute"/>
  <Command x:Name="cmd_crop" Label="{Res cmd_crop}" SmallIcon="Crop" OnExecute="crop_execute"/>
  <Command x:Name="cmd_replace_img" Label="{Res cmd_replace_img}" SmallIcon="Image" OnExecute="replace_img_execute"/>
  <Command x:Name="cmd_img_reset" Label="{Res cmd_img_reset}" SmallIcon="Maximize2" OnExecute="img_reset_execute"/>
  <!-- Insertion and the toolbar -->
  <Command x:Name="cmd_tool_select" Label="{Res cmd_tool_select}" SmallIcon="MousePointer" IsCheckable="true" Checked="{Binding ToolSelect}" OnExecute="tool_select_execute"/>
  <Command x:Name="cmd_tool_text" Label="{Res cmd_tool_text}" SmallIcon="Type" IsCheckable="true" Checked="{Binding ToolText}" OnExecute="tool_text_execute"/>
  <Command x:Name="cmd_image" Label="{Res cmd_image}" SmallIcon="Image" LargeIcon="Image" OnExecute="image_execute"/>
  <Command x:Name="cmd_textbox" Label="{Res cmd_textbox}" SmallIcon="Type" OnExecute="textbox_execute"/>
  <Command x:Name="cmd_separator" Label="{Res cmd_separator}" SmallIcon="Minus" OnExecute="separator_execute"/>
  <Command x:Name="cmd_field_number" Label="{Res cmd_field_number}" SmallIcon="Hash" OnExecute="field_number_execute"/>
  <Command x:Name="cmd_field_date" Label="{Res cmd_field_date}" SmallIcon="Calendar" OnExecute="field_date_execute"/>
  <Command x:Name="cmd_field_time" Label="{Res cmd_field_time}" SmallIcon="Clock" OnExecute="field_time_execute"/>
  <Command x:Name="cmd_geometry" Label="{Res cmd_geometry}" SmallIcon="Settings2" OnExecute="geometry_execute"/>
  <!-- Text format -->
  <Command x:Name="cmd_bold" Label="{Res cmd_bold}" SmallIcon="Bold" Shortcut="Ctrl+B" IsCheckable="true" Checked="{Binding Bold}" OnExecute="bold_execute"/>
  <Command x:Name="cmd_italic" Label="{Res cmd_italic}" SmallIcon="Italic" Shortcut="Ctrl+I" IsCheckable="true" Checked="{Binding Italic}" OnExecute="italic_execute"/>
  <Command x:Name="cmd_underline" Label="{Res cmd_underline}" SmallIcon="Underline" Shortcut="Ctrl+U" IsCheckable="true" Checked="{Binding Underline}" OnExecute="underline_execute"/>
  <Command x:Name="cmd_strike" Label="{Res cmd_strike}" SmallIcon="Strikethrough" IsCheckable="true" Checked="{Binding Strike}" OnExecute="strike_execute"/>
  <Command x:Name="cmd_sup" Label="{Res cmd_sup}" SmallIcon="Superscript" IsCheckable="true" Checked="{Binding Superscript}" OnExecute="sup_execute"/>
  <Command x:Name="cmd_sub" Label="{Res cmd_sub}" SmallIcon="Subscript" IsCheckable="true" Checked="{Binding Subscript}" OnExecute="sub_execute"/>
  <Command x:Name="cmd_tal_left" Label="{Res cmd_tal_left}" SmallIcon="AlignLeft" IsCheckable="true" Checked="{Binding TextLeft}" OnExecute="tal_left_execute"/>
  <Command x:Name="cmd_tal_center" Label="{Res cmd_tal_center}" SmallIcon="AlignCenter" IsCheckable="true" Checked="{Binding TextCenter}" OnExecute="tal_center_execute"/>
  <Command x:Name="cmd_tal_right" Label="{Res cmd_tal_right}" SmallIcon="AlignRight" IsCheckable="true" Checked="{Binding TextRight}" OnExecute="tal_right_execute"/>
  <Command x:Name="cmd_tal_justify" Label="{Res cmd_tal_justify}" SmallIcon="AlignJustify" IsCheckable="true" Checked="{Binding TextJustify}" OnExecute="tal_justify_execute"/>
  <Command x:Name="cmd_bullets" Label="{Res cmd_bullets}" SmallIcon="List" IsCheckable="true" Checked="{Binding ListBullet}" OnExecute="bullets_execute"/>
  <Command x:Name="cmd_numbers" Label="{Res cmd_numbers}" SmallIcon="ListOrdered" IsCheckable="true" Checked="{Binding ListNumber}" OnExecute="numbers_execute"/>
  <Command x:Name="cmd_indent_out" Label="{Res cmd_indent_out}" SmallIcon="IndentDecrease" OnExecute="indent_out_execute"/>
  <Command x:Name="cmd_indent_in" Label="{Res cmd_indent_in}" SmallIcon="IndentIncrease" OnExecute="indent_in_execute"/>
  <Command x:Name="cmd_clear_fmt" Label="{Res cmd_clear_fmt}" SmallIcon="RemoveFormatting" OnExecute="clear_fmt_execute"/>
  <!-- Effets -->
  <Command x:Name="cmd_op100" Label="100 %" OnExecute="op100_execute"/>
  <Command x:Name="cmd_op75" Label="75 %" OnExecute="op75_execute"/>
  <Command x:Name="cmd_op50" Label="50 %" OnExecute="op50_execute"/>
  <Command x:Name="cmd_op25" Label="25 %" OnExecute="op25_execute"/>
  <!-- File -->
  <Command x:Name="cmd_open_file" Label="{Res cmd_open_file}" SmallIcon="FolderOpen" Shortcut="Ctrl+O" OnExecute="open_file_execute"/>
  <Command x:Name="cmd_save_copy" Label="{Res cmd_save_copy}" SmallIcon="Download" OnExecute="save_copy_execute"/>

  <!-- The slide list's right-click menu (`buildSections`). -->
  <ContextMenu x:Name="slide_menu">
    <MenuItem Command="cmd_cut_slides" ShortcutKeyDisplayString="Ctrl+X"/>
    <MenuItem Command="cmd_copy_slides" ShortcutKeyDisplayString="Ctrl+C"/>
    <MenuItem Command="cmd_paste_slides" ShortcutKeyDisplayString="Ctrl+V"/>
    <MenuItem Command="cmd_paste_plain" ShortcutKeyDisplayString="Ctrl+Maj+V"/>
    <MenuItem Command="cmd_del_slides" Danger="true"/>
    <MenuSeparator/>
    <MenuItem Command="cmd_new_slide" ShortcutKeyDisplayString="Ctrl+M"/>
    <MenuItem Text="{Res menu_create_slide}" Icon="FilePlus2">
      <MenuItem Command="cmd_new_slide" Text="{Res menu_create_editable}"/>
      <MenuItem Command="cmd_dup_slide" Text="{Res menu_create_image}"/>
    </MenuItem>
    <MenuItem Command="cmd_dup_slide"/>
    <MenuItem Command="cmd_hide_slides"/>
    <MenuItem Command="cmd_move_up"/>
    <MenuItem Command="cmd_move_down"/>
    <MenuSeparator/>
    <MenuItem Command="cmd_background"/>
    <MenuItem Command="cmd_layout_disabled"/>
    <MenuItem Command="cmd_theme"/>
    <MenuSeparator/>
    <MenuItem Command="cmd_transition_menu"/>
    <MenuSeparator/>
    <MenuItem Command="cmd_comment" ShortcutKeyDisplayString="Ctrl+Alt+M"/>
  </ContextMenu>

  <!-- An element's right-click menu (`elementMenuSections`). -->
  <ContextMenu x:Name="element_menu" OnItemClicked="element_menu_item_clicked">
    <MenuItem Command="cmd_cut_el" ShortcutKeyDisplayString="Ctrl+X"/>
    <MenuItem Command="cmd_copy_el" ShortcutKeyDisplayString="Ctrl+C"/>
    <MenuItem Command="cmd_paste_el" ShortcutKeyDisplayString="Ctrl+V"/>
    <MenuItem Command="cmd_paste_plain"/>
    <MenuItem Command="cmd_delete_el" ShortcutKeyDisplayString="Suppr"/>
    <MenuSeparator/>
    <MenuItem Command="cmd_alt"/>
    <MenuItem Text="{Res menu_rotate}" Icon="RotateCw">
      <MenuItem Command="cmd_rot_right"/>
      <MenuItem Command="cmd_rot_left"/>
      <MenuItem Command="cmd_flip_h"/>
      <MenuItem Command="cmd_flip_v"/>
      <MenuItem Command="cmd_rot_reset"/>
    </MenuItem>
    <MenuItem Command="cmd_same_type"/>
    <MenuItem Text="{Res menu_center}" Icon="Focus">
      <MenuItem Command="cmd_center_h"/>
      <MenuItem Command="cmd_center_v"/>
    </MenuItem>
    <MenuItem Command="cmd_duplicate"/>
    <MenuItem Command="cmd_group"/>
    <MenuItem Command="cmd_ungroup"/>
    <MenuSeparator/>
    <MenuItem Text="{Res menu_order}" Icon="Layers">
      <MenuItem Command="cmd_front"/>
      <MenuItem Command="cmd_forward"/>
      <MenuItem Command="cmd_backward"/>
      <MenuItem Command="cmd_back"/>
    </MenuItem>
    <MenuItem Text="{Res menu_align}" Icon="AlignCenter">
      <MenuItem Command="cmd_al_left"/>
      <MenuItem Command="cmd_al_center"/>
      <MenuItem Command="cmd_al_right"/>
      <MenuItem Command="cmd_al_top"/>
      <MenuItem Command="cmd_al_middle"/>
      <MenuItem Command="cmd_al_bottom"/>
      <MenuItem Command="cmd_dist_h"/>
      <MenuItem Command="cmd_dist_v"/>
    </MenuItem>
    <MenuSeparator/>
    <MenuItem x:Name="menu_animate" Text="{Res menu_animate}" Icon="Sparkles">
      <MenuItem x:Name="anim_none" Text="{Res anim_none}" OnClick="anim_none_click"/>
      <MenuItem x:Name="anim_fade" Text="{Res anim_fade}" OnClick="anim_fade_click"/>
      <MenuItem x:Name="anim_flyl" Text="{Res anim_flyl}" OnClick="anim_flyl_click"/>
      <MenuItem x:Name="anim_flyr" Text="{Res anim_flyr}" OnClick="anim_flyr_click"/>
      <MenuItem x:Name="anim_flyt" Text="{Res anim_flyt}" OnClick="anim_flyt_click"/>
      <MenuItem x:Name="anim_flyb" Text="{Res anim_flyb}" OnClick="anim_flyb_click"/>
      <MenuItem x:Name="anim_zoom" Text="{Res anim_zoom}" OnClick="anim_zoom_click"/>
      <MenuItem x:Name="anim_rise" Text="{Res anim_rise}" OnClick="anim_rise_click"/>
      <MenuItem x:Name="anim_spin" Text="{Res anim_spin}" OnClick="anim_spin_click"/>
      <MenuItem x:Name="anim_flip" Text="{Res anim_flip}" OnClick="anim_flip_click"/>
      <MenuItem x:Name="anim_swivel" Text="{Res anim_swivel}" OnClick="anim_swivel_click"/>
      <MenuItem x:Name="anim_growturn" Text="{Res anim_growturn}" OnClick="anim_growturn_click"/>
      <MenuItem x:Name="anim_expand" Text="{Res anim_expand}" OnClick="anim_expand_click"/>
      <MenuItem x:Name="anim_pulse" Text="{Res anim_pulse}" OnClick="anim_pulse_click"/>
      <MenuItem x:Name="anim_bounce" Text="{Res anim_bounce}" OnClick="anim_bounce_click"/>
      <MenuItem x:Name="anim_dropin" Text="{Res anim_dropin}" OnClick="anim_dropin_click"/>
      <MenuItem x:Name="anim_wiper" Text="{Res anim_wiper}" OnClick="anim_wiper_click"/>
      <MenuItem x:Name="anim_wipeu" Text="{Res anim_wipeu}" OnClick="anim_wipeu_click"/>
      <MenuItem x:Name="anim_flytl" Text="{Res anim_flytl}" OnClick="anim_flytl_click"/>
      <MenuItem x:Name="anim_flybr" Text="{Res anim_flybr}" OnClick="anim_flybr_click"/>
    </MenuItem>
    <MenuItem Command="cmd_link"/>
    <MenuSeparator/>
    <MenuItem Command="cmd_copy_style"/>
    <MenuItem Command="cmd_paste_style"/>
    <MenuItem Text="{Res menu_opacity}" Icon="Droplet">
      <MenuItem Command="cmd_op100"/>
      <MenuItem Command="cmd_op75"/>
      <MenuItem Command="cmd_op50"/>
      <MenuItem Command="cmd_op25"/>
    </MenuItem>
    <MenuItem Command="cmd_shadow"/>
    <MenuItem Command="cmd_lock"/>
    <MenuItem Command="cmd_hide_el"/>
    <MenuSeparator Visible="{Binding ShapeSelected}"/>
    <MenuItem x:Name="menu_change_shape" Text="{Res menu_change_shape}" Icon="Shapes" Visible="{Binding ShapeSelected}" ItemsSource="{Binding ChangeShapeRows}"/>
    <MenuItem Text="{Res menu_quick_style}" Icon="Wand2" Visible="{Binding ShapeSelected}">
      <MenuItem x:Name="qs_0" Text="{Res qs_0}" OnClick="qs_0_click"/>
      <MenuItem x:Name="qs_1" Text="{Res qs_1}" OnClick="qs_1_click"/>
      <MenuItem x:Name="qs_2" Text="{Res qs_2}" OnClick="qs_2_click"/>
      <MenuItem x:Name="qs_3" Text="{Res qs_3}" OnClick="qs_3_click"/>
      <MenuItem x:Name="qs_4" Text="{Res qs_4}" OnClick="qs_4_click"/>
      <MenuItem x:Name="qs_5" Text="{Res qs_5}" OnClick="qs_5_click"/>
      <MenuItem x:Name="qs_6" Text="{Res qs_6}" OnClick="qs_6_click"/>
      <MenuItem x:Name="qs_7" Text="{Res qs_7}" OnClick="qs_7_click"/>
    </MenuItem>
    <MenuItem Text="{Res menu_corner}" Icon="Square" Visible="{Binding RoundRectSelected}">
      <MenuItem x:Name="cr_8" Text="8 px" OnClick="cr_8_click"/>
      <MenuItem x:Name="cr_16" Text="16 px" OnClick="cr_16_click"/>
      <MenuItem x:Name="cr_24" Text="24 px" OnClick="cr_24_click"/>
      <MenuItem x:Name="cr_40" Text="40 px" OnClick="cr_40_click"/>
    </MenuItem>
    <MenuSeparator Visible="{Binding ImageSelected}"/>
    <MenuItem Text="{Res menu_filters}" Icon="Wand2" Visible="{Binding ImageSelected}">
      <MenuItem x:Name="flt_none" Text="{Res flt_none}" OnClick="flt_none_click"/>
      <MenuItem x:Name="flt_gray" Text="{Res flt_gray}" OnClick="flt_gray_click"/>
      <MenuItem x:Name="flt_sepia" Text="{Res flt_sepia}" OnClick="flt_sepia_click"/>
      <MenuItem x:Name="flt_bright" Text="{Res flt_bright}" OnClick="flt_bright_click"/>
      <MenuItem x:Name="flt_dark" Text="{Res flt_dark}" OnClick="flt_dark_click"/>
      <MenuItem x:Name="flt_contrast" Text="{Res flt_contrast}" OnClick="flt_contrast_click"/>
      <MenuItem x:Name="flt_saturate" Text="{Res flt_saturate}" OnClick="flt_saturate_click"/>
      <MenuItem x:Name="flt_blur" Text="{Res flt_blur}" OnClick="flt_blur_click"/>
      <MenuItem x:Name="flt_cold" Text="{Res flt_cold}" OnClick="flt_cold_click"/>
    </MenuItem>
    <MenuItem Text="{Res menu_border}" Icon="Square" Visible="{Binding ImageSelected}">
      <MenuItem x:Name="bd_none" Text="{Res bd_none}" OnClick="bd_none_click"/>
      <MenuItem x:Name="bd_thin" Text="{Res bd_thin}" OnClick="bd_thin_click"/>
      <MenuItem x:Name="bd_white" Text="{Res bd_white}" OnClick="bd_white_click"/>
      <MenuItem x:Name="bd_blue" Text="{Res bd_blue}" OnClick="bd_blue_click"/>
    </MenuItem>
    <MenuItem Text="{Res menu_corner}" Icon="Square" Visible="{Binding ImageSelected}">
      <MenuItem x:Name="ir_0" Text="0 px" OnClick="ir_0_click"/>
      <MenuItem x:Name="ir_8" Text="8 px" OnClick="ir_8_click"/>
      <MenuItem x:Name="ir_16" Text="16 px" OnClick="ir_16_click"/>
      <MenuItem x:Name="ir_32" Text="32 px" OnClick="ir_32_click"/>
    </MenuItem>
    <MenuItem Text="{Res menu_tint}" Icon="Droplet" Visible="{Binding ImageSelected}">
      <MenuItem x:Name="tint_none" Text="{Res tint_none}" OnClick="tint_none_click"/>
      <MenuItem x:Name="tint_blue" Text="{Res tint_blue}" OnClick="tint_blue_click"/>
      <MenuItem x:Name="tint_warm" Text="{Res tint_warm}" OnClick="tint_warm_click"/>
      <MenuItem x:Name="tint_green" Text="{Res tint_green}" OnClick="tint_green_click"/>
    </MenuItem>
    <MenuSeparator Visible="{Binding TextSelected}"/>
    <MenuItem Text="{Res menu_text_effects}" Icon="Sparkles" Visible="{Binding TextSelected}">
      <MenuItem x:Name="fx_shadow" Text="{Res fx_shadow}" OnClick="fx_shadow_click"/>
      <MenuItem x:Name="fx_outline" Text="{Res fx_outline}" OnClick="fx_outline_click"/>
      <MenuItem x:Name="fx_wa_blue" Text="{Res fx_wa_blue}" OnClick="fx_wa_blue_click"/>
      <MenuItem x:Name="fx_wa_gold" Text="{Res fx_wa_gold}" OnClick="fx_wa_gold_click"/>
      <MenuItem x:Name="fx_wa_none" Text="{Res fx_wa_none}" OnClick="fx_wa_none_click"/>
    </MenuItem>
    <MenuItem Text="{Res menu_case}" Icon="CaseSensitive" Visible="{Binding TextSelected}">
      <MenuItem x:Name="case_none" Text="{Res case_none}" OnClick="case_none_click"/>
      <MenuItem x:Name="case_upper" Text="{Res case_upper}" OnClick="case_upper_click"/>
      <MenuItem x:Name="case_lower" Text="{Res case_lower}" OnClick="case_lower_click"/>
      <MenuItem x:Name="case_capitalize" Text="{Res case_capitalize}" OnClick="case_capitalize_click"/>
    </MenuItem>
    <MenuItem Text="{Res menu_spacing}" Icon="MoveHorizontal" Visible="{Binding TextSelected}">
      <MenuItem x:Name="ls_0" Text="0 px" OnClick="ls_0_click"/>
      <MenuItem x:Name="ls_1" Text="1 px" OnClick="ls_1_click"/>
      <MenuItem x:Name="ls_2" Text="2 px" OnClick="ls_2_click"/>
      <MenuItem x:Name="ls_4" Text="4 px" OnClick="ls_4_click"/>
    </MenuItem>
    <MenuItem Text="{Res menu_columns}" Icon="Columns2" Visible="{Binding TextSelected}">
      <MenuItem x:Name="col_1" Text="1" OnClick="col_1_click"/>
      <MenuItem x:Name="col_2" Text="2" OnClick="col_2_click"/>
    </MenuItem>
    <MenuSeparator Visible="{Binding LineSelected}"/>
    <MenuItem Command="cmd_arrow_end" Visible="{Binding LineSelected}"/>
    <MenuItem Command="cmd_arrow_start" Visible="{Binding LineSelected}"/>
    <MenuItem Text="{Res menu_arrow_size}" Icon="MoveUpRight" Visible="{Binding LineSelected}">
      <MenuItem x:Name="as_8" Text="8 px" OnClick="as_8_click"/>
      <MenuItem x:Name="as_12" Text="12 px" OnClick="as_12_click"/>
      <MenuItem x:Name="as_18" Text="18 px" OnClick="as_18_click"/>
      <MenuItem x:Name="as_26" Text="26 px" OnClick="as_26_click"/>
    </MenuItem>
    <MenuItem Text="{Res menu_line_width}" Icon="Minus" Visible="{Binding LineSelected}">
      <MenuItem x:Name="lw_1" Text="1 px" OnClick="lw_1_click"/>
      <MenuItem x:Name="lw_2" Text="2 px" OnClick="lw_2_click"/>
      <MenuItem x:Name="lw_4" Text="4 px" OnClick="lw_4_click"/>
      <MenuItem x:Name="lw_6" Text="6 px" OnClick="lw_6_click"/>
      <MenuItem x:Name="lw_10" Text="10 px" OnClick="lw_10_click"/>
    </MenuItem>
    <MenuItem Text="{Res menu_line_style}" Icon="PenLine" Visible="{Binding LineSelected}">
      <MenuItem x:Name="dash_solid" Text="{Res dash_solid}" OnClick="dash_solid_click"/>
      <MenuItem x:Name="dash_dashed" Text="{Res dash_dashed}" OnClick="dash_dashed_click"/>
      <MenuItem x:Name="dash_dotted" Text="{Res dash_dotted}" OnClick="dash_dotted_click"/>
    </MenuItem>
  </ContextMenu>

  <!-- The slide ground's right-click menu (`canvasMenuSections`). -->
  <ContextMenu x:Name="canvas_menu">
    <MenuItem Text="{Res cmd_cut}" Icon="Scissors" Enabled="false"/>
    <MenuItem Text="{Res cmd_copy}" Icon="Copy" Enabled="false"/>
    <MenuItem Text="{Res cmd_paste}" Icon="ClipboardPaste" Enabled="false"/>
    <MenuItem Command="cmd_paste_plain"/>
    <MenuItem Text="{Res cmd_delete}" Icon="Trash2" Enabled="false"/>
    <MenuSeparator/>
    <MenuItem Command="cmd_bg_dialog"/>
    <MenuItem Text="{Res cmd_layout}" Icon="LayoutTemplate">
      <MenuItem x:Name="lay_title" Text="{Res lay_title}" OnClick="lay_title_click"/>
      <MenuItem x:Name="lay_section" Text="{Res lay_section}" OnClick="lay_section_click"/>
      <MenuItem x:Name="lay_title_body" Text="{Res lay_title_body}" OnClick="lay_title_body_click"/>
      <MenuItem x:Name="lay_two_col" Text="{Res lay_two_col}" OnClick="lay_two_col_click"/>
      <MenuItem x:Name="lay_title_only" Text="{Res lay_title_only}" OnClick="lay_title_only_click"/>
      <MenuItem x:Name="lay_one_col" Text="{Res lay_one_col}" OnClick="lay_one_col_click"/>
      <MenuItem x:Name="lay_main" Text="{Res lay_main}" OnClick="lay_main_click"/>
      <MenuItem x:Name="lay_section_desc" Text="{Res lay_section_desc}" OnClick="lay_section_desc_click"/>
      <MenuItem x:Name="lay_caption" Text="{Res lay_caption}" OnClick="lay_caption_click"/>
      <MenuItem x:Name="lay_number" Text="{Res lay_number}" OnClick="lay_number_click"/>
      <MenuItem x:Name="lay_blank" Text="{Res lay_blank}" OnClick="lay_blank_click"/>
    </MenuItem>
    <MenuItem Command="cmd_theme"/>
    <MenuSeparator/>
    <MenuItem Command="cmd_transition_menu"/>
    <MenuSeparator/>
    <MenuItem Command="cmd_comment" ShortcutKeyDisplayString="Ctrl+Alt+M"/>
    <MenuSeparator/>
    <MenuItem Text="{Res menu_guides}" Icon="Hash">
      <MenuItem Text="{Res guides_show}" Icon="Eye" OnClick="guides_show_click"/>
      <MenuItem Text="{Res guides_add_v}" Icon="Plus" OnClick="guides_add_v_click"/>
      <MenuItem Text="{Res guides_add_h}" Icon="Plus" OnClick="guides_add_h_click"/>
      <MenuItem Text="{Res guides_edit}" Icon="AlignVerticalSpaceAround" OnClick="guides_edit_click"/>
      <MenuItem Text="{Res guides_clear}" Icon="Trash2" OnClick="guides_clear_click"/>
    </MenuItem>
  </ContextMenu>

  <!-- The text box's fit button. -->
  <ContextMenu x:Name="fit_menu">
    <MenuItem x:Name="mfit_none" Text="{Res fit_none}" Icon="Ban" Checked="{Binding FitNone}" OnClick="mfit_none_click"/>
    <MenuItem x:Name="mfit_shape" Text="{Res fit_shape}" Icon="AlignVerticalSpaceAround" Checked="{Binding FitShape}" OnClick="mfit_shape_click"/>
    <MenuItem x:Name="mfit_shrink" Text="{Res fit_shrink}" Icon="Shrink" Checked="{Binding FitShrink}" OnClick="mfit_shrink_click"/>
  </ContextMenu>

  <!-- The zoom pill's % menu (of the fitted size). -->
  <ContextMenu x:Name="zoom_menu">
    <MenuItem x:Name="zoom_50" Text="50%" OnClick="zoom_50_click"/>
    <MenuItem x:Name="zoom_75" Text="75%" OnClick="zoom_75_click"/>
    <MenuItem x:Name="zoom_100" Text="100%" OnClick="zoom_100_click"/>
    <MenuItem x:Name="zoom_150" Text="150%" OnClick="zoom_150_click"/>
    <MenuItem x:Name="zoom_200" Text="200%" OnClick="zoom_200_click"/>
  </ContextMenu>

  <Ribbon x:Name="ribbon" Dock="Top" Tone="Presentation">
    <RibbonQuickAccessToolbar>
      <RibbonButton x:Name="qat_save" Command="cmd_save"/>
      <RibbonButton x:Name="qat_undo" Command="cmd_undo"/>
      <RibbonButton x:Name="qat_redo" Command="cmd_redo"/>
