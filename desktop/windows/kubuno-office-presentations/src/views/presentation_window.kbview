    <RibbonTab x:Name="tab_arrange" Header="{Res tab_arrange}" KeyTip="D">
      <RibbonGroup x:Name="grp_align" Header="{Res grp_align}">
        <RibbonButton Command="cmd_al_left" ShowLabel="false"/>
        <RibbonButton Command="cmd_al_center" ShowLabel="false"/>
        <RibbonButton Command="cmd_al_right" ShowLabel="false"/>
        <RibbonButton Command="cmd_al_top" ShowLabel="false"/>
        <RibbonButton Command="cmd_al_middle" ShowLabel="false"/>
        <RibbonButton Command="cmd_al_bottom" ShowLabel="false"/>
      </RibbonGroup>
      <RibbonGroup x:Name="grp_distribute" Header="{Res grp_distribute}">
        <RibbonButton Command="cmd_dist_h"/>
        <RibbonButton Command="cmd_dist_v"/>
      </RibbonGroup>
      <RibbonGroup x:Name="grp_order" Header="{Res grp_order}">
        <RibbonButton Command="cmd_front" Size="Large"/>
        <RibbonButton Command="cmd_back" Size="Large"/>
        <RibbonButton Command="cmd_forward"/>
        <RibbonButton Command="cmd_backward"/>
      </RibbonGroup>
      <RibbonGroup x:Name="grp_group" Header="{Res grp_group}">
        <RibbonButton Command="cmd_group"/>
        <RibbonButton Command="cmd_ungroup"/>
      </RibbonGroup>
      <RibbonGroup x:Name="grp_size" Header="{Res grp_size}">
        <RibbonButton Command="cmd_same_w"/>
        <RibbonButton Command="cmd_same_h"/>
        <RibbonButton Command="cmd_same_both"/>
        <RibbonButton Command="cmd_swap"/>
        <RibbonButton Command="cmd_rotate90"/>
        <RibbonButton Command="cmd_flip_h"/>
        <RibbonButton Command="cmd_flip_v"/>
        <RibbonButton Command="cmd_center_slide"/>
        <RibbonButton Command="cmd_stretch_w"/>
        <RibbonButton Command="cmd_stretch_h"/>
      </RibbonGroup>
      <RibbonGroup x:Name="grp_object" Header="{Res grp_object}">
        <RibbonButton Command="cmd_duplicate"/>
        <RibbonButton Command="cmd_delete_el"/>
      </RibbonGroup>
    </RibbonTab>
    <RibbonTab x:Name="tab_anim" Header="{Res tab_anim}" KeyTip="A">
      <RibbonGroup x:Name="grp_animation" Header="{Res grp_animation}">
        <RibbonComboBox x:Name="cb_anim_entry" Width="170" SelectedValue="{Binding AnimEntry}" OnSelectedValueChanged="anim_entry_changed">
          <Option Value="none" Label="{Res anim_none}"/>
          <Option Value="fade" Label="{Res anim_fade}"/>
          <Option Value="flyL" Label="{Res anim_flyl}"/>
          <Option Value="flyR" Label="{Res anim_flyr}"/>
          <Option Value="flyT" Label="{Res anim_flyt}"/>
          <Option Value="flyB" Label="{Res anim_flyb}"/>
          <Option Value="zoom" Label="{Res anim_zoom}"/>
          <Option Value="rise" Label="{Res anim_rise}"/>
          <Option Value="spin" Label="{Res anim_spin}"/>
          <Option Value="flip" Label="{Res anim_flip}"/>
          <Option Value="swivel" Label="{Res anim_swivel}"/>
          <Option Value="growturn" Label="{Res anim_growturn}"/>
          <Option Value="expand" Label="{Res anim_expand}"/>
          <Option Value="pulse" Label="{Res anim_pulse}"/>
          <Option Value="bounce" Label="{Res anim_bounce}"/>
          <Option Value="dropin" Label="{Res anim_dropin}"/>
          <Option Value="wiper" Label="{Res anim_wiper}"/>
          <Option Value="wipeu" Label="{Res anim_wipeu}"/>
          <Option Value="flyTL" Label="{Res anim_flytl}"/>
          <Option Value="flyBR" Label="{Res anim_flybr}"/>
        </RibbonComboBox>
        <RibbonComboBox x:Name="cb_anim_exit" Width="170" SelectedValue="{Binding AnimExit}" OnSelectedValueChanged="anim_exit_changed">
          <Option Value="none" Label="{Res anim_exit_none}"/>
          <Option Value="fade" Label="{Res anim_fade}"/>
          <Option Value="flyL" Label="{Res anim_flyl}"/>
          <Option Value="flyR" Label="{Res anim_flyr}"/>
          <Option Value="flyT" Label="{Res anim_flyt}"/>
          <Option Value="flyB" Label="{Res anim_flyb}"/>
          <Option Value="zoom" Label="{Res anim_zoom}"/>
          <Option Value="rise" Label="{Res anim_rise}"/>
          <Option Value="spin" Label="{Res anim_spin}"/>
          <Option Value="flip" Label="{Res anim_flip}"/>
          <Option Value="swivel" Label="{Res anim_swivel}"/>
          <Option Value="growturn" Label="{Res anim_growturn}"/>
          <Option Value="expand" Label="{Res anim_expand}"/>
          <Option Value="pulse" Label="{Res anim_pulse}"/>
          <Option Value="bounce" Label="{Res anim_bounce}"/>
          <Option Value="dropin" Label="{Res anim_dropin}"/>
          <Option Value="wiper" Label="{Res anim_wiper}"/>
          <Option Value="wipeu" Label="{Res anim_wipeu}"/>
          <Option Value="flyTL" Label="{Res anim_flytl}"/>
          <Option Value="flyBR" Label="{Res anim_flybr}"/>
        </RibbonComboBox>
      </RibbonGroup>
      <RibbonGroup x:Name="grp_timing" Header="{Res grp_timing}">
        <RibbonComboBox x:Name="cb_anim_duration" Width="110" SelectedValue="{Binding AnimDuration}" OnSelectedValueChanged="anim_duration_changed">
          <Option Value="250" Label="0,25 s"/>
          <Option Value="450" Label="0,5 s"/>
          <Option Value="1000" Label="1 s"/>
          <Option Value="2000" Label="2 s"/>
        </RibbonComboBox>
        <RibbonComboBox x:Name="cb_anim_delay" Width="110" SelectedValue="{Binding AnimDelay}" OnSelectedValueChanged="anim_delay_changed">
          <Option Value="0" Label="{Res delay_none}"/>
          <Option Value="250" Label="0,25 s"/>
          <Option Value="500" Label="0,5 s"/>
          <Option Value="1000" Label="1 s"/>
        </RibbonComboBox>
      </RibbonGroup>
    </RibbonTab>
    <RibbonTab x:Name="tab_trans" Header="{Res tab_trans}" KeyTip="K">
      <RibbonGroup x:Name="grp_transition" Header="{Res grp_transition}">
        <RibbonComboBox x:Name="cb_trans_type" Width="170" SelectedValue="{Binding TransType}" OnSelectedValueChanged="trans_type_changed">
          <Option Value="none" Label="{Res trans_none}"/>
          <Option Value="fade" Label="{Res trans_fade}"/>
          <Option Value="slideL" Label="{Res trans_slidel}"/>
          <Option Value="slideR" Label="{Res trans_slider}"/>
          <Option Value="slideU" Label="{Res trans_slideu}"/>
          <Option Value="zoom" Label="{Res trans_zoom}"/>
          <Option Value="flip" Label="{Res trans_flip}"/>
          <Option Value="pushU" Label="{Res trans_pushu}"/>
          <Option Value="wipeR" Label="{Res trans_wiper}"/>
          <Option Value="cover" Label="{Res trans_cover}"/>
          <Option Value="split" Label="{Res trans_split}"/>
          <Option Value="rotate" Label="{Res trans_rotate}"/>
        </RibbonComboBox>
        <RibbonComboBox x:Name="cb_trans_duration" Width="110" SelectedValue="{Binding TransDuration}" OnSelectedValueChanged="trans_duration_changed">
          <Option Value="250" Label="0,25 s"/>
          <Option Value="500" Label="0,5 s"/>
          <Option Value="1000" Label="1 s"/>
          <Option Value="1500" Label="1,5 s"/>
        </RibbonComboBox>
      </RibbonGroup>
    </RibbonTab>
    <RibbonContextualTabGroup x:Name="ctx_shape" Header="{Res ctx_drawing}" Color="#b7472a" Visible="{Binding ShapeSelected}">
      <RibbonTab x:Name="tab_shape" Header="{Res tab_shape}">
        <RibbonGroup x:Name="grp_shape_style" Header="{Res grp_style}">
          <RibbonColorPicker x:Name="cb_shape_fill" Label="{Res shape_fill}" SmallIcon="PaintBucket" SelectedColor="{Binding ShapeFill}" OnSelectedColorChanged="shape_fill_changed"/>
          <RibbonColorPicker x:Name="cb_shape_stroke" Label="{Res shape_stroke}" SmallIcon="Square" SelectedColor="{Binding ShapeStroke}" OnSelectedColorChanged="shape_stroke_changed"/>
          <RibbonButton x:Name="shape_no_fill" Label="{Res shape_no_fill}" SmallIcon="Ban" OnClick="shape_no_fill_click"/>
          <RibbonButton x:Name="shape_no_stroke" Label="{Res shape_no_stroke}" SmallIcon="Ban" OnClick="shape_no_stroke_click"/>
        </RibbonGroup>
        <RibbonGroup x:Name="grp_shape_arrange" Header="{Res grp_arrange}">
          <RibbonMenuButton x:Name="menu_shape_align" Label="{Res menu_align}" SmallIcon="AlignCenter">
            <RibbonMenuItem Command="cmd_al_left"/>
            <RibbonMenuItem Command="cmd_al_center"/>
            <RibbonMenuItem Command="cmd_al_right"/>
            <RibbonMenuItem Command="cmd_al_top"/>
            <RibbonMenuItem Command="cmd_al_middle"/>
            <RibbonMenuItem Command="cmd_al_bottom"/>
            <RibbonSeparator/>
            <RibbonMenuItem Command="cmd_dist_h"/>
            <RibbonMenuItem Command="cmd_dist_v"/>
          </RibbonMenuButton>
          <RibbonButton x:Name="shape_front" Label="{Res cmd_forward}" SmallIcon="BringToFront" OnClick="front_execute"/>
          <RibbonButton x:Name="shape_back" Label="{Res cmd_backward}" SmallIcon="SendToBack" OnClick="back_execute"/>
          <RibbonButton x:Name="shape_rot_l" Label="{Res rot_left90}" SmallIcon="RotateCcw" OnClick="rot_left_execute"/>
          <RibbonButton x:Name="shape_rot_r" Label="{Res rot_right90}" SmallIcon="RotateCw" OnClick="rot_right_execute"/>
        </RibbonGroup>
        <RibbonGroup x:Name="grp_shape_object" Header="{Res grp_object}">
          <RibbonButton Command="cmd_delete_el" Size="Large"/>
        </RibbonGroup>
        <RibbonGroup x:Name="grp_effects" Header="{Res grp_effects}">
          <RibbonMenuButton x:Name="menu_opacity" Label="{Res menu_opacity}" SmallIcon="Droplet">
            <RibbonMenuItem Command="cmd_op100"/>
            <RibbonMenuItem Command="cmd_op75"/>
            <RibbonMenuItem Command="cmd_op50"/>
            <RibbonMenuItem Command="cmd_op25"/>
          </RibbonMenuButton>
          <RibbonToggleButton Command="cmd_shadow"/>
        </RibbonGroup>
      </RibbonTab>
    </RibbonContextualTabGroup>
  </Ribbon>

  <!-- The floating toolbar row (`SlideToolbar`): the tools, then what the selection can do. -->
  <Panel x:Name="toolbar" Dock="Top" Height="44" BackColor="Surface1">
    <Panel x:Name="toolbar_rule" Dock="Bottom" Height="1" BackColor="Border"/>
    <IconButton x:Name="tb_select" Dock="Left" Width="36" Icon="MousePointer" Diameter="32" Glyph="16" ToolTip="{Res cmd_tool_select}" AccessibleName="{Res cmd_tool_select}" Filled="{Binding ToolSelect}" OnClick="tool_select_execute"/>
    <IconButton x:Name="tb_text" Dock="Left" Width="36" Icon="Type" Diameter="32" Glyph="16" ToolTip="{Res cmd_tool_text}" AccessibleName="{Res cmd_tool_text}" Filled="{Binding ToolText}" OnClick="tool_text_execute"/>
    <IconButton x:Name="tb_line" Dock="Left" Width="36" Icon="Minus" Diameter="32" Glyph="16" ToolTip="{Res menu_lines}" AccessibleName="{Res menu_lines}" Filled="{Binding ToolLine}" DropDownMenu="line_menu"/>
    <IconButton x:Name="tb_image" Dock="Left" Width="36" Icon="Image" Diameter="32" Glyph="16" ToolTip="{Res cmd_image}" AccessibleName="{Res cmd_image}" OnClick="image_execute"/>
    <IconButton x:Name="tb_chart" Dock="Left" Width="36" Icon="BarChart3" Diameter="32" Glyph="16" ToolTip="{Res menu_chart}" AccessibleName="{Res menu_chart}" DropDownMenu="chart_menu"/>
    <IconButton x:Name="tb_table" Dock="Left" Width="36" Icon="Table" Diameter="32" Glyph="16" ToolTip="{Res menu_table}" AccessibleName="{Res menu_table}" DropDownMenu="table_menu"/>
    <IconButton x:Name="tb_smartart" Dock="Left" Width="36" Icon="Workflow" Diameter="32" Glyph="16" ToolTip="SmartArt" AccessibleName="SmartArt" DropDownMenu="smartart_menu"/>
    <IconButton x:Name="tb_extras" Dock="Left" Width="36" Icon="Plus" Diameter="32" Glyph="16" ToolTip="{Res insert_extras}" AccessibleName="{Res insert_extras}" DropDownMenu="extras_menu"/>
    <IconButton x:Name="tb_geometry" Dock="Left" Width="36" Icon="Settings2" Diameter="32" Glyph="16" ToolTip="{Res cmd_geometry}" AccessibleName="{Res cmd_geometry}" Visible="{Binding HasGeometry}" OnClick="geometry_execute"/>
    <Panel x:Name="tb_sep1" Dock="Left" Width="13" Visible="{Binding TextSelected}"/>
    <ComboBox x:Name="tb_font" Dock="Left" Width="150" Visible="{Binding TextSelected}" SelectedValue="{Binding FontFamily}" ItemsSource="{Binding FontFamilies}" OnSelectedValueChanged="font_family_changed" AccessibleName="{Res font}"/>
    <ComboBox x:Name="tb_size" Dock="Left" Width="64" Visible="{Binding TextSelected}" SelectedValue="{Binding FontSize}" ItemsSource="{Binding FontSizes}" OnSelectedValueChanged="font_size_changed" AccessibleName="{Res font_size}"/>
    <IconButton x:Name="tb_bold" Dock="Left" Width="32" Icon="Bold" Diameter="30" Glyph="15" Visible="{Binding TextSelected}" Filled="{Binding Bold}" ToolTip="{Res cmd_bold}" AccessibleName="{Res cmd_bold}" OnClick="bold_execute"/>
    <IconButton x:Name="tb_italic" Dock="Left" Width="32" Icon="Italic" Diameter="30" Glyph="15" Visible="{Binding TextSelected}" Filled="{Binding Italic}" ToolTip="{Res cmd_italic}" AccessibleName="{Res cmd_italic}" OnClick="italic_execute"/>
    <IconButton x:Name="tb_underline" Dock="Left" Width="32" Icon="Underline" Diameter="30" Glyph="15" Visible="{Binding TextSelected}" Filled="{Binding Underline}" ToolTip="{Res cmd_underline}" AccessibleName="{Res cmd_underline}" OnClick="underline_execute"/>
    <IconButton x:Name="tb_strike" Dock="Left" Width="32" Icon="Strikethrough" Diameter="30" Glyph="15" Visible="{Binding TextSelected}" Filled="{Binding Strike}" ToolTip="{Res cmd_strike}" AccessibleName="{Res cmd_strike}" OnClick="strike_execute"/>
    <IconButton x:Name="tb_sup" Dock="Left" Width="32" Icon="Superscript" Diameter="30" Glyph="15" Visible="{Binding TextSelected}" Filled="{Binding Superscript}" ToolTip="{Res cmd_sup}" AccessibleName="{Res cmd_sup}" OnClick="sup_execute"/>
    <IconButton x:Name="tb_sub" Dock="Left" Width="32" Icon="Subscript" Diameter="30" Glyph="15" Visible="{Binding TextSelected}" Filled="{Binding Subscript}" ToolTip="{Res cmd_sub}" AccessibleName="{Res cmd_sub}" OnClick="sub_execute"/>
    <ColorField x:Name="tb_color" Dock="Left" Width="36" Visible="{Binding TextSelected}" Color="{Binding TextColor}" ToolTip="{Res text_color}" AccessibleName="{Res text_color}" OnValueChanged="text_color_changed"/>
    <ColorField x:Name="tb_highlight" Dock="Left" Width="36" Visible="{Binding TextSelected}" Color="{Binding HighlightColor}" ToolTip="{Res highlight}" AccessibleName="{Res highlight}" OnValueChanged="highlight_changed"/>
    <IconButton x:Name="tb_al_left" Dock="Left" Width="32" Icon="AlignLeft" Diameter="30" Glyph="15" Visible="{Binding TextSelected}" Filled="{Binding TextLeft}" ToolTip="{Res cmd_tal_left}" AccessibleName="{Res cmd_tal_left}" OnClick="tal_left_execute"/>
    <IconButton x:Name="tb_al_center" Dock="Left" Width="32" Icon="AlignCenter" Diameter="30" Glyph="15" Visible="{Binding TextSelected}" Filled="{Binding TextCenter}" ToolTip="{Res cmd_tal_center}" AccessibleName="{Res cmd_tal_center}" OnClick="tal_center_execute"/>
    <IconButton x:Name="tb_al_right" Dock="Left" Width="32" Icon="AlignRight" Diameter="30" Glyph="15" Visible="{Binding TextSelected}" Filled="{Binding TextRight}" ToolTip="{Res cmd_tal_right}" AccessibleName="{Res cmd_tal_right}" OnClick="tal_right_execute"/>
    <IconButton x:Name="tb_al_justify" Dock="Left" Width="32" Icon="AlignJustify" Diameter="30" Glyph="15" Visible="{Binding TextSelected}" Filled="{Binding TextJustify}" ToolTip="{Res cmd_tal_justify}" AccessibleName="{Res cmd_tal_justify}" OnClick="tal_justify_execute"/>
    <IconButton x:Name="tb_spacing" Dock="Left" Width="32" Icon="AlignVerticalSpaceAround" Diameter="30" Glyph="15" Visible="{Binding TextSelected}" ToolTip="{Res line_spacing}" AccessibleName="{Res line_spacing}" DropDownMenu="spacing_menu"/>
    <IconButton x:Name="tb_bullets" Dock="Left" Width="32" Icon="List" Diameter="30" Glyph="15" Visible="{Binding TextSelected}" Filled="{Binding ListBullet}" ToolTip="{Res cmd_bullets}" AccessibleName="{Res cmd_bullets}" OnClick="bullets_execute"/>
    <IconButton x:Name="tb_numbers" Dock="Left" Width="32" Icon="ListOrdered" Diameter="30" Glyph="15" Visible="{Binding TextSelected}" Filled="{Binding ListNumber}" ToolTip="{Res cmd_numbers}" AccessibleName="{Res cmd_numbers}" OnClick="numbers_execute"/>
    <IconButton x:Name="tb_indent_out" Dock="Left" Width="32" Icon="IndentDecrease" Diameter="30" Glyph="15" Visible="{Binding TextSelected}" ToolTip="{Res cmd_indent_out}" AccessibleName="{Res cmd_indent_out}" OnClick="indent_out_execute"/>
    <IconButton x:Name="tb_indent_in" Dock="Left" Width="32" Icon="IndentIncrease" Diameter="30" Glyph="15" Visible="{Binding TextSelected}" ToolTip="{Res cmd_indent_in}" AccessibleName="{Res cmd_indent_in}" OnClick="indent_in_execute"/>
    <IconButton x:Name="tb_clear" Dock="Left" Width="32" Icon="RemoveFormatting" Diameter="30" Glyph="15" Visible="{Binding TextSelected}" ToolTip="{Res cmd_clear_fmt}" AccessibleName="{Res cmd_clear_fmt}" OnClick="clear_fmt_execute"/>
    <Button x:Name="tb_crop" Dock="Left" Width="90" Text="{Res cmd_crop}" Variant="Ghost" Visible="{Binding ImageSelected}" OnClick="crop_execute"/>
    <Button x:Name="tb_replace" Dock="Left" Width="150" Text="{Res cmd_replace_img}" Variant="Ghost" Visible="{Binding ImageSelected}" OnClick="replace_img_execute"/>
    <ComboBox x:Name="tb_chart_type" Dock="Left" Width="140" Visible="{Binding ChartSelected}" ItemsSource="{Binding ChartTypes}" DisplayMember="Text" ValueMember="Value" SelectedValue="{Binding ChartType}" AccessibleName="{Res chart_type}" OnSelectedValueChanged="chart_type_changed"/>
    <Button x:Name="tb_chart_data" Dock="Left" Width="90" Text="{Res chart_data}" Variant="Ghost" Visible="{Binding ChartSelected}" OnClick="chart_data_click"/>
    <CheckBox x:Name="tb_chart_legend" Dock="Left" Width="90" Text="{Res chart_legend}" Visible="{Binding ChartSelected}" Checked="{Binding ChartLegend}" OnCheckedChanged="chart_legend_changed"/>
    <Button x:Name="tb_row_add" Dock="Left" Width="44" Text="+L" Variant="Ghost" Visible="{Binding TableSelected}" OnClick="row_add_click"/>
    <Button x:Name="tb_row_del" Dock="Left" Width="44" Text="âˆ’L" Variant="Ghost" Visible="{Binding TableSelected}" OnClick="row_del_click"/>
    <Button x:Name="tb_col_add" Dock="Left" Width="44" Text="+C" Variant="Ghost" Visible="{Binding TableSelected}" OnClick="col_add_click"/>
    <Button x:Name="tb_col_del" Dock="Left" Width="44" Text="âˆ’C" Variant="Ghost" Visible="{Binding TableSelected}" OnClick="col_del_click"/>
    <CheckBox x:Name="tb_header" Dock="Left" Width="90" Text="{Res table_header}" Visible="{Binding TableSelected}" Checked="{Binding TableHeader}" OnCheckedChanged="table_header_changed"/>
    <CheckBox x:Name="tb_banded" Dock="Left" Width="90" Text="{Res table_banded}" Visible="{Binding TableSelected}" Checked="{Binding TableBanded}" OnCheckedChanged="table_banded_changed"/>
    <CheckBox x:Name="tb_firstcol" Dock="Left" Width="90" Text="{Res table_firstcol}" Visible="{Binding TableSelected}" Checked="{Binding TableFirstCol}" OnCheckedChanged="table_firstcol_changed"/>
    <IconButton x:Name="tb_table_style" Dock="Left" Width="32" Icon="Palette" Diameter="30" Glyph="15" Visible="{Binding TableSelected}" ToolTip="{Res table_style}" AccessibleName="{Res table_style}" DropDownMenu="table_style_menu"/>
    <ColorField x:Name="tb_tborder" Dock="Left" Width="36" Visible="{Binding TableSelected}" Color="{Binding TableBorder}" ToolTip="{Res table_border}" AccessibleName="{Res table_border}" OnValueChanged="table_border_changed"/>
    <ComboBox x:Name="tb_tfont" Dock="Left" Width="72" Visible="{Binding TableSelected}" SelectedValue="{Binding TableFont}" ItemsSource="{Binding TableFontSizes}" AccessibleName="{Res font_size}" OnSelectedValueChanged="table_font_changed"/>
    <IconButton x:Name="tb_treset" Dock="Left" Width="32" Icon="RemoveFormatting" Diameter="30" Glyph="15" Visible="{Binding TableSelected}" ToolTip="{Res table_reset}" AccessibleName="{Res table_reset}" OnClick="table_reset_click"/>
    <Button x:Name="tb_bg" Dock="Left" Width="132" Text="{Res background}" Icon="Square" Variant="Ghost" Visible="{Binding NothingSelected}" ToolTip="{Res slide_background}" OnClick="bg_dialog_execute"/>
    <Button x:Name="tb_theme" Dock="Left" Width="100" Text="{Res theme}" Icon="ChevronDown" Variant="Ghost" Enabled="false" Visible="{Binding NothingSelected}"/>
    <Button x:Name="tb_transition" Dock="Left" Width="124" Text="{Res transition}" Icon="ChevronDown" Variant="Ghost" Enabled="false" Visible="{Binding NothingSelected}"/>
    <Button x:Name="tb_format" Dock="Left" Width="170" Text="{Res format_options}" Variant="Ghost" Enabled="false" Visible="{Binding TextOrImage}"/>
    <Button x:Name="tb_animate" Dock="Left" Width="70" Text="{Res animate}" Variant="Ghost" Enabled="false" Visible="{Binding TextOrImage}"/>
  </Panel>
  <ContextMenu x:Name="extras_menu" OnItemClicked="extras_item_clicked">
    <MenuItem Text="Emoji" Icon="Smile" ItemsSource="{Binding EmojiRows}"/>
    <MenuItem Text="{Res tab_symbols}" Icon="Omega" ItemsSource="{Binding SymbolRows}"/>
    <MenuItem Text="{Res tab_fields}" Icon="Hash">
      <MenuItem Command="cmd_field_number"/>
      <MenuItem Command="cmd_field_date"/>
      <MenuItem Command="cmd_field_time"/>
      <MenuSeparator/>
      <MenuItem x:Name="pr_title" Text="{Res pr_title}" OnClick="pr_title_click"/>
      <MenuItem x:Name="pr_text" Text="{Res pr_text}" OnClick="pr_text_click"/>
      <MenuItem x:Name="pr_quote" Text="{Res pr_quote}" OnClick="pr_quote_click"/>
      <MenuItem x:Name="pr_footer" Text="{Res pr_footer}" OnClick="pr_footer_click"/>
      <MenuItem x:Name="pr_two_col" Text="{Res pr_two_col}" OnClick="pr_two_col_click"/>
      <MenuItem x:Name="pr_bullets" Text="{Res pr_bullets}" OnClick="pr_bullets_click"/>
      <MenuItem Command="cmd_separator"/>
    </MenuItem>
  </ContextMenu>
  <ContextMenu x:Name="line_menu">
    <MenuItem x:Name="tl_straight" Text="{Res ln_straight}" Icon="Minus" OnClick="tl_straight_click"/>
    <MenuItem x:Name="tl_arrow" Text="{Res ln_arrow}" Icon="MoveUpRight" OnClick="tl_arrow_click"/>
    <MenuItem x:Name="tl_elbow" Text="{Res ln_elbow}" Icon="CornerDownRight" OnClick="tl_elbow_click"/>
    <MenuItem x:Name="tl_curved" Text="{Res ln_curved}" Icon="Spline" OnClick="tl_curved_click"/>
    <MenuItem x:Name="tl_arc" Text="{Res ln_arc}" Icon="Cable" OnClick="tl_arc_click"/>
    <MenuItem x:Name="tl_polyline" Text="{Res ln_polyline}" Icon="Waypoints" OnClick="tl_polyline_click"/>
    <MenuItem x:Name="tl_freehand" Text="{Res ln_freehand}" Icon="PenTool" OnClick="tl_freehand_click"/>
  </ContextMenu>
  <ContextMenu x:Name="chart_menu">
    <MenuItem x:Name="tc_column" Text="{Res ch_column}" OnClick="tc_column_click"/>
    <MenuItem x:Name="tc_bar" Text="{Res ch_bar}" OnClick="tc_bar_click"/>
    <MenuItem x:Name="tc_line" Text="{Res ch_line}" OnClick="tc_line_click"/>
    <MenuItem x:Name="tc_area" Text="{Res ch_area}" OnClick="tc_area_click"/>
    <MenuItem x:Name="tc_pie" Text="{Res ch_pie}" OnClick="tc_pie_click"/>
    <MenuItem x:Name="tc_donut" Text="{Res ch_donut}" OnClick="tc_donut_click"/>
  </ContextMenu>
  <ContextMenu x:Name="table_menu">
    <MenuItem x:Name="tt_2x2" Text="2 Ã— 2" OnClick="tt_2x2_click"/>
    <MenuItem x:Name="tt_3x3" Text="3 Ã— 3" OnClick="tt_3x3_click"/>
    <MenuItem x:Name="tt_3x4" Text="3 Ã— 4" OnClick="tt_3x4_click"/>
    <MenuItem x:Name="tt_4x4" Text="4 Ã— 4" OnClick="tt_4x4_click"/>
    <MenuItem x:Name="tt_5x5" Text="5 Ã— 5" OnClick="tt_5x5_click"/>
    <MenuItem x:Name="tt_6x6" Text="6 Ã— 6" OnClick="tt_6x6_click"/>
    <MenuItem x:Name="tt_8x8" Text="8 Ã— 8" OnClick="tt_8x8_click"/>
  </ContextMenu>
  <ContextMenu x:Name="smartart_menu">
    <MenuItem x:Name="ts_process" Text="{Res sa_process}" OnClick="ts_process_click"/>
    <MenuItem x:Name="ts_list" Text="{Res sa_list}" OnClick="ts_list_click"/>
    <MenuItem x:Name="ts_cycle" Text="{Res sa_cycle}" OnClick="ts_cycle_click"/>
    <MenuItem x:Name="ts_hierarchy" Text="{Res sa_hierarchy}" OnClick="ts_hierarchy_click"/>
    <MenuItem x:Name="ts_pyramid" Text="{Res sa_pyramid}" OnClick="ts_pyramid_click"/>
    <MenuItem x:Name="ts_matrix" Text="{Res sa_matrix}" OnClick="ts_matrix_click"/>
  </ContextMenu>
  <ContextMenu x:Name="spacing_menu">
    <MenuItem x:Name="lh_1" Text="1.0" OnClick="lh_1_click"/>
    <MenuItem x:Name="lh_115" Text="1.15" OnClick="lh_115_click"/>
    <MenuItem x:Name="lh_15" Text="1.5" OnClick="lh_15_click"/>
    <MenuItem x:Name="lh_2" Text="2.0" OnClick="lh_2_click"/>
  </ContextMenu>
  <ContextMenu x:Name="table_style_menu">
    <MenuItem x:Name="ts_0" Text="{Res ts_0}" OnClick="ts_0_click"/>
    <MenuItem x:Name="ts_1" Text="{Res ts_1}" OnClick="ts_1_click"/>
    <MenuItem x:Name="ts_2" Text="{Res ts_2}" OnClick="ts_2_click"/>
    <MenuItem x:Name="ts_3" Text="{Res ts_3}" OnClick="ts_3_click"/>
    <MenuItem x:Name="ts_4" Text="{Res ts_4}" OnClick="ts_4_click"/>
  </ContextMenu>

  <!-- The status bar (`StatusBar`): the slide, the objects, the save state, the mode. -->
  <Panel x:Name="status_band" Dock="Bottom" Height="28" BackColor="Surface1">
    <Panel x:Name="status_rule" Dock="Top" Height="1" BackColor="Border"/>
    <StatusBar x:Name="status_bar" Dock="Fill">
      <StatusLabel x:Name="lbl_status_slide" Text="{Binding StatusSlide}"/>
      <StatusLabel x:Name="lbl_status_objects" Text="{Binding StatusObjects}" Visible="{Binding HasActive}"/>
      <StatusLabel x:Name="status_spring" Spring="true"/>
      <StatusLabel x:Name="status_sync" Text="{Binding SyncStatus}" Visible="{Binding HasSync}"/>
      <StatusLabel x:Name="lbl_status_mode" Text="{Binding StatusMode}"/>
    </StatusBar>
  </Panel>

  <!-- The slide list (resizable 120â€“360, 150 by default). -->
  <SlidePanel x:Name="slides" Dock="Left" Width="150" OnPanelChanged="slides_panel_changed"/>

  <!-- The slide panel on the right (`w-48`). -->
  <Panel x:Name="side" Dock="Right" Width="192" BackColor="Surface1">
    <Panel x:Name="side_rule" Dock="Left" Width="1" BackColor="Border"/>
    <Label x:Name="side_title" Text="{Res side_slide}" Role="Micro" X="13" Y="12" Width="170" Height="16"/>
    <Label x:Name="side_pos_label" Text="{Res side_position}" ForeColor="TextSecondary" X="13" Y="40" Width="170" Height="16" Visible="{Binding HasActive}"/>
    <Label x:Name="side_pos" Text="{Binding SidePosition}" X="13" Y="58" Width="170" Height="18" Visible="{Binding HasActive}"/>
    <Label x:Name="side_els_label" Text="{Res side_elements}" ForeColor="TextSecondary" X="13" Y="88" Width="170" Height="16" Visible="{Binding HasActive}"/>
    <Label x:Name="side_els" Text="{Binding SideElements}" X="13" Y="106" Width="170" Height="18" Visible="{Binding HasActive}"/>
    <Label x:Name="side_bg_label" Text="{Res side_background}" ForeColor="TextSecondary" X="13" Y="136" Width="170" Height="16" Visible="{Binding HasActive}"/>
    <ColorField x:Name="side_bg_color" X="13" Y="156" Width="28" Height="22" Color="{Binding BgColor}" Visible="{Binding HasActive}" AccessibleName="{Res bg_color}" OnValueChanged="bg_color_changed"/>
    <GradientField x:Name="side_bg_gradient" X="49" Y="156" Width="52" Height="22" Value="{Binding BgGradient}" Visible="{Binding HasActive}" AccessibleName="{Res bg_gradient}" OnValueChanged="bg_gradient_changed"/>
    <IconButton x:Name="side_bg_image" X="109" Y="156" Width="28" Height="22" Icon="Image" Diameter="22" Glyph="14" ToolTip="{Res bg_image}" AccessibleName="{Res bg_image}" Visible="{Binding HasActive}" OnClick="bg_image_click"/>
    <LinkLabel x:Name="side_bg_all" Text="{Res bg_apply_all}" X="13" Y="186" Width="170" Height="18" Visible="{Binding HasActive}" OnClick="bg_all_click"/>
    <LinkLabel x:Name="side_delete" Text="{Res side_delete}" X="13" Y="216" Width="170" Height="18" Visible="{Binding HasActive}" OnClick="side_delete_click"/>
    <LinkLabel x:Name="side_duplicate" Text="{Res side_duplicate}" X="13" Y="244" Width="170" Height="18" Visible="{Binding HasActive}" OnClick="side_duplicate_click"/>
    <LinkLabel x:Name="side_hide" Text="{Binding SideHideLabel}" X="13" Y="272" Width="170" Height="18" Visible="{Binding HasActive}" OnClick="side_hide_click"/>
  </Panel>

  <!-- The centre: the presenter notes under the canvas. -->
  <Panel x:Name="center" Dock="Fill">
    <Panel x:Name="notes_pane" Dock="Bottom" Height="100" BackColor="Surface1" Visible="{Binding HasActive}">
      <Panel x:Name="notes_rule" Dock="Top" Height="1" BackColor="Border"/>
      <Label x:Name="notes_title" Text="{Res notes_title}" Role="Micro" X="12" Y="7" Width="400" Height="14"/>
      <TextArea x:Name="notes_box" Text="{Binding Notes, Mode=TwoWay}" Placeholder="{Res notes_placeholder}" AccessibleName="{Res notes_title}" X="8" Y="24" Width="1000" Height="72" Anchor="Top, Bottom, Left, Right" OnTextChanged="notes_changed"/>
    </Panel>
    <SlideCanvas x:Name="canvas" Dock="Fill" OnStateChanged="canvas_state_changed" OnMenuRequested="canvas_menu_requested" OnImageAction="canvas_image_action"/>
  </Panel>
</Panel>
