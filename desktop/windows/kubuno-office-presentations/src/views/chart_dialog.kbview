<!--
  The chart bar's « Données » (`ChartEditor`): the chart's title and its data as text, the first line naming the
  series (`Cat,S1,S2` then `A,3,5`…; commas, tabs or semicolons). ChartDialog (chart_dialog.rs) reads it back.
-->
<Panel xmlns="https://kubuno.com/views" xmlns:x="https://kubuno.com/views/x" DesignWidth="420" DesignHeight="300" WindowKind="Dialog" Title="{Res chart_data}" AcceptButton="ok" CancelButton="cancel">
  <Label x:Name="title_label" Text="{Res chart_title}" ForeColor="TextSecondary" X="24" Y="16" Width="372" Height="18"/>
  <TextField x:Name="title_box" Text="{Binding ChartTitle, Mode=TwoWay}" X="24" Y="36" Width="372" Height="32" Anchor="Top, Left, Right"/>
  <Label x:Name="data_label" Text="{Res chart_data_hint}" ForeColor="TextSecondary" X="24" Y="78" Width="372" Height="18"/>
  <TextArea x:Name="data_box" Text="{Binding DataText, Mode=TwoWay}" AcceptsReturn="true" X="24" Y="98" Width="372" Height="140" Anchor="Top, Bottom, Left, Right"/>
  <Button x:Name="cancel" ActionBar.Region="Right" Text="{Res cancel}" Variant="Secondary" Width="96" Height="36" OnClick="cancel_click"/>
  <Button x:Name="ok" ActionBar.Region="Right" Text="{Res chart_apply}" Variant="Primary" Width="104" Height="36" OnClick="ok_click"/>
</Panel>
