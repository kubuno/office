<!--
  A one-line question (the web's `prompt({ title, placeholder, confirmLabel })` of @ui): the address of an e-mail
  link, the name of a bookmark. PromptDialog (prompt_dialog.rs) sets the title, the placeholder and the
  confirm label, and reads the answer back.
-->
<Panel xmlns="https://kubuno.com/views" xmlns:x="https://kubuno.com/views/x" DesignWidth="420" DesignHeight="96" WindowKind="Dialog" Title="Kubuno" AcceptButton="ok" CancelButton="cancel">
  <TextField x:Name="answer_box" Text="{Binding Answer, Mode=TwoWay}" Placeholder="{Binding Hint}" X="24" Y="24" Width="372" Height="32" Anchor="Top, Left, Right"/>
  <Button x:Name="cancel" ActionBar.Region="Right" Text="{Res cancel}" Variant="Secondary" Width="96" Height="36" OnClick="cancel_click"/>
  <Button x:Name="ok" ActionBar.Region="Right" Text="OK" Variant="Primary" Width="104" Height="36" OnClick="ok_click"/>
</Panel>
