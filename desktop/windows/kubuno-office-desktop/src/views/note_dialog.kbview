<!--
  The note editor (Insertion / Références › Note de bas de page, Note de fin, or a click on a note's
  reference): the web's small window with a text area, « Supprimer la note » on the left and OK /
  Annuler on the right (DocumentEditorPage.tsx fnDlg, documents/EndnoteDialog.tsx). Notes are plain
  text, as on the web. NoteDialog (note_dialog.rs) fills it in and reads it back.
-->
<Panel xmlns="https://kubuno.com/views" xmlns:x="https://kubuno.com/views/x" DesignWidth="440" DesignHeight="152" WindowKind="Dialog" Title="{Res note_footnote}" AcceptButton="ok">
  <TextArea x:Name="text_box" Text="{Binding NoteText, Mode=TwoWay}" Placeholder="{Res note_placeholder}" X="16" Y="16" Width="408" Height="100" Anchor="Top, Bottom, Left, Right"/>
  <Button x:Name="delete" ActionBar.Region="Left" Text="{Res note_delete}" Variant="Secondary" Width="170" Height="36" OnClick="delete_click"/>
  <Button x:Name="cancel" ActionBar.Region="Right" Text="{Res cancel}" Variant="Secondary" Width="96" Height="36" OnClick="cancel_click"/>
  <Button x:Name="ok" ActionBar.Region="Right" Text="OK" Variant="Primary" Width="96" Height="36" OnClick="ok_click"/>
</Panel>
