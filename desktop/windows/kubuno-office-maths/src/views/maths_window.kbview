<!--
  Kubuno Maths' window, laid out like the web Maths editor (MathsApp.tsx): the tall 64-DIP title bar of the
  Office editors with the waffle and the account menus, the ribbon (Fichier, Accueil, Insertion, Équation,
  Calcul), and the formula sheet canvas filling the body, with a status bar. MathsWindow (maths_window.rs)
  opens the formula into the canvas and binds what it reports to the ribbon, the Backstage and the status bar.
  Increment A is read-only; the Insertion / Équation / Calcul commands land in increment B.
-->
<Panel xmlns="https://kubuno.com/views" xmlns:x="https://kubuno.com/views/x" DesignWidth="1280" DesignHeight="840" Title="{Binding WindowTitle}" Icon="{Res app_icon}" ShowIcon="false"
       TitleBarStyle="Tall" ShowWaffle="true" ShowAccount="true"
       OnLoad="maths_window_load">
  <!-- The quick access toolbar and the shortcuts. -->
  <Command x:Name="cmd_save" Label="{Res cmd_save}" SmallIcon="Save" Shortcut="Ctrl+S" Enabled="{Binding CanSave}" OnExecute="save_execute"/>
  <Command x:Name="cmd_undo" Label="{Res cmd_undo}" SmallIcon="Undo2" Shortcut="Ctrl+Z" Enabled="{Binding CanUndo}" OnExecute="undo_execute"/>
  <Command x:Name="cmd_redo" Label="{Res cmd_redo}" SmallIcon="Redo2" Shortcut="Ctrl+Y" Enabled="{Binding CanRedo}" OnExecute="redo_execute"/>
  <Command x:Name="cmd_star" Label="{Res cmd_star}" SmallIcon="Star" IsCheckable="true" Checked="{Binding Starred}" Enabled="{Binding IsServer}" OnExecute="star_execute"/>
  <!-- Accueil. -->
  <Command x:Name="cmd_new" Label="{Res cmd_new}" SmallIcon="FilePlus" OnExecute="new_execute"/>
  <Command x:Name="cmd_dup" Label="{Res cmd_dup}" SmallIcon="CopyPlus" Enabled="{Binding IsServer}" OnExecute="dup_execute"/>
  <Command x:Name="cmd_visual" Label="{Res cmd_visual}" SmallIcon="MousePointerSquareDashed" IsCheckable="true" Checked="{Binding VisualMode}" OnExecute="visual_execute"/>
  <Command x:Name="cmd_code" Label="{Res cmd_code}" SmallIcon="Code2" IsCheckable="true" Checked="{Binding CodeMode}" OnExecute="code_execute"/>
  <Command x:Name="cmd_zin" Label="{Res cmd_zin}" SmallIcon="ZoomIn" OnExecute="zin_execute"/>
  <Command x:Name="cmd_zout" Label="{Res cmd_zout}" SmallIcon="ZoomOut" OnExecute="zout_execute"/>
  <Command x:Name="cmd_zreset" Label="{Res cmd_zreset}" SmallIcon="RotateCcw" OnExecute="zreset_execute"/>
  <!-- Insertion (increment B). -->
  <Command x:Name="cmd_ins_formula" Label="{Res cmd_ins_formula}" SmallIcon="Sigma" OnExecute="ins_formula_execute"/>
  <Command x:Name="cmd_ins_graph" Label="{Res cmd_ins_graph}" SmallIcon="LineChart" OnExecute="ins_graph_execute"/>
  <Command x:Name="cmd_ins_text" Label="{Res cmd_ins_text}" SmallIcon="Type" OnExecute="ins_text_execute"/>
  <Command x:Name="cmd_add_page" Label="{Res cmd_add_page}" SmallIcon="Plus" OnExecute="add_page_execute"/>

  <Ribbon x:Name="ribbon" Dock="Top" Tone="Documents">
    <RibbonQuickAccessToolbar>
      <RibbonButton x:Name="qat_save" Command="cmd_save"/>
      <RibbonButton x:Name="qat_undo" Command="cmd_undo"/>
      <RibbonButton x:Name="qat_redo" Command="cmd_redo"/>
      <RibbonToggleButton x:Name="qat_star" Command="cmd_star"/>
    </RibbonQuickAccessToolbar>
    <RibbonBackstage x:Name="backstage" Header="{Res tab_file}" KeyTip="F">
      <BackstageTab x:Name="bs_info" Header="{Res bs_info}" Icon="Info">
        <Panel x:Name="bs_info_panel">
          <Label x:Name="bs_title_cap" Text="{Res info_title}" X="24" Y="24" Width="120" Height="20"/>
          <Label x:Name="bs_title_val" Text="{Binding DocTitle}" X="160" Y="24" Width="400" Height="20"/>
          <Label x:Name="bs_type_cap" Text="{Res info_type}" X="24" Y="52" Width="120" Height="20"/>
          <Label x:Name="bs_type_val" Text="{Res info_type_value}" X="160" Y="52" Width="400" Height="20"/>
          <Label x:Name="bs_pages_cap" Text="{Res info_pages}" X="24" Y="80" Width="120" Height="20"/>
          <Label x:Name="bs_pages_val" Text="{Binding PagesText}" X="160" Y="80" Width="400" Height="20"/>
          <Label x:Name="bs_blocks_cap" Text="{Res info_blocks}" X="24" Y="108" Width="120" Height="20"/>
          <Label x:Name="bs_blocks_val" Text="{Binding BlocksText}" X="160" Y="108" Width="400" Height="20"/>
        </Panel>
      </BackstageTab>
      <BackstageSeparator/>
      <BackstageButton x:Name="bs_close" Label="{Res bs_close}" SmallIcon="X" OnClick="bs_close_click"/>
    </RibbonBackstage>
    <RibbonTab x:Name="tab_home" Header="{Res tab_home}" KeyTip="H">
      <RibbonGroup x:Name="grp_doc" Header="{Res grp_doc}">
        <RibbonButton Command="cmd_new" Size="Large"/>
        <RibbonButton Command="cmd_dup"/>
      </RibbonGroup>
      <RibbonGroup x:Name="grp_mode" Header="{Res grp_mode}">
        <RibbonToggleButton Command="cmd_visual" Size="Large"/>
        <RibbonToggleButton Command="cmd_code" Size="Large"/>
      </RibbonGroup>
      <RibbonGroup x:Name="grp_zoom" Header="{Res grp_zoom}">
        <RibbonButton Command="cmd_zin"/>
        <RibbonButton Command="cmd_zout"/>
        <RibbonButton Command="cmd_zreset"/>
      </RibbonGroup>
    </RibbonTab>
    <RibbonTab x:Name="tab_insert" Header="{Res tab_insert}" KeyTip="N">
      <RibbonGroup x:Name="grp_blocks" Header="{Res grp_blocks}">
        <RibbonButton Command="cmd_ins_formula" Size="Large"/>
        <RibbonButton Command="cmd_ins_graph"/>
        <RibbonButton Command="cmd_ins_text"/>
        <RibbonButton Command="cmd_add_page"/>
      </RibbonGroup>
    </RibbonTab>
    <RibbonTab x:Name="tab_equation" Header="{Res tab_equation}" KeyTip="E">
      <RibbonGroup x:Name="grp_eq_blocks" Header="{Res grp_blocks}">
        <RibbonButton Command="cmd_ins_formula" Size="Large"/>
      </RibbonGroup>
    </RibbonTab>
    <RibbonTab x:Name="tab_calc" Header="{Res tab_calc}" KeyTip="C">
      <RibbonGroup x:Name="grp_calc_blocks" Header="{Res grp_blocks}">
        <RibbonButton Command="cmd_ins_graph" Size="Large"/>
      </RibbonGroup>
    </RibbonTab>
  </Ribbon>

  <!-- The status bar. -->
  <Panel x:Name="status_band" Dock="Bottom" Height="28" BackColor="Surface1">
    <Panel x:Name="status_rule" Dock="Top" Height="1" BackColor="Border"/>
    <StatusBar x:Name="status_bar" Dock="Fill">
      <StatusLabel x:Name="status_pages" Text="{Binding PagesText}"/>
      <StatusLabel x:Name="status_blocks" Text="{Binding BlocksText}"/>
      <StatusLabel x:Name="status_spring" Spring="true"/>
      <StatusLabel x:Name="status_zoom" Text="{Binding ZoomText}"/>
    </StatusBar>
  </Panel>

  <!-- The body: the formula sheet. -->
  <Panel x:Name="canvas_host" Dock="Fill">
    <MathsCanvas x:Name="canvas" AccessibleName="{Res acc_canvas}" Dock="Fill" OnStateChanged="canvas_state_changed"/>
  </Panel>
</Panel>
